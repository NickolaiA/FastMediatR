<Project>

  <!--
    Centrally-managed NuGet package versions (CPM).
    Task 0.5 per task breakdown.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source Link / packaging -->
    <!-- 8.0.0 has CVE-2026-62900 (GHSA-23fw-v26w-5fgq) via Microsoft.Build.Tasks.Git — fixed in 10.0.404. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.404" />

    <!-- Microsoft.Extensions.* (DI, Logging, Options) -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />

    <!-- FluentValidation (built-in ValidationBehavior) -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />

    <!-- Roslyn (Source Generator) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />

    <!-- OpenTelemetry (FastMediatR.Telemetry) -->
    <!-- Versions ≤1.11.2 have CVEs GHSA-8785-wc3w-h8q6 and GHSA-g94r-2vxg-569j (DoS via header parsing) — fixed in 1.15.3. -->
    <!-- 1.20.0 is the last release depending on System.Diagnostics.DiagnosticSource 10.x; 1.21.x moved to the .NET 11 band (DiagnosticSource 11). Bump when retargeting net11.0. -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.20.0" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.15" />

    <!-- Test stack (design §12 / DotNet.md §16) -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageVersion Include="xunit.v3" Version="1.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
    <!-- 1.1.2 is the highest released version of the testing verifier suite (no 1.1.4 exists) —
         the Verifiers packages lag the core testing package's release train. Do not bump in lockstep. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Testing.Verifiers.XUnit" Version="1.1.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />

    <!-- MediatR: used by Integration.Tests for behavioral parity comparisons -->
    <PackageVersion Include="MediatR" Version="12.4.1" />

    <!-- Sample API (no Swashbuckle per docs/DotNet.md — first-party OpenApi + Scalar) -->
    <!-- 10.0.0 pulls Microsoft.OpenApi 2.0.0 (CVE-2026-49451, GHSA-v5pm-xwqc-g5wc, DoS via circular $ref) — patched in 2.7.5; 10.0.15 resolves ≥2.13.0. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Scalar.AspNetCore" Version="1.2.71" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
  </ItemGroup>

</Project>
