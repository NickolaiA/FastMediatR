<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FastMediatR.Telemetry.Tests
    Unit tests for FastMediatR.Telemetry (TracingBehavior, DI registration, builder extensions).
    Phase 6: OpenTelemetry ActivitySource pipeline behavior.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>FastMediatR.Telemetry.Tests</RootNamespace>
    <!-- Test code is exempt from CS1591 XML doc enforcement -->
    <!-- CA1707: tests follow the Method_Under_Test_Scenario naming convention -->
    <!-- CA1062: tests deliberately exercise null/edge cases without defensive guards -->
    <!-- IDE0008: var preference is enforced in library code, relaxed in tests -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1062;IDE0008</NoWarn>
    <!-- Tests do not need to be AOT/trim safe -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FastMediatR.Telemetry\FastMediatR.Telemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
